# Waydrop Mobile App Environment Configuration
# Set EXPO_PUBLIC_API_BASE_URL to hit the real Laravel API backend.
# If left empty or unset, the app uses the in-app mock backend.

# Local Web / iOS Simulator:
EXPO_PUBLIC_API_BASE_URL=http://127.0.0.1:8000/api

# Android Emulator (uncomment if testing on Android Studio emulator):
# EXPO_PUBLIC_API_BASE_URL=http://10.0.2.2:8000/api

# Physical Device (replace with your development PC LAN IP e.g. 192.168.1.15):
# EXPO_PUBLIC_API_BASE_URL=http://192.168.1.X:8000/api
